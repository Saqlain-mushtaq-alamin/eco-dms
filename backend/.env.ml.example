# Environment Configuration for ML Verifier
# Add these to your .env file

# ============================================
# IPFS Configuration
# ============================================
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080

# ============================================
# Redis Configuration (Celery Broker + Cache)
# ============================================
REDIS_URL=redis://127.0.0.1:6379/0

# ============================================
# ML Verifier Configuration
# ============================================

# Path to your trained YOLOv8 model
# Place your model at: backend/ml/models/yolov8_eco.pt
YOLO_MODEL_PATH=ml/models/yolov8_eco.pt

# Verifier Private Key (for signing verdicts)
# Generate with: python -c "from eth_account import Account; acc = Account.create(); print(f'Key: {acc.key.hex()}'); print(f'Address: {acc.address}')"
# IMPORTANT: Keep this secret! Anyone with this key can sign verdicts as your verifier
VERIFIER_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Verifier Address (derived from private key above)
# This becomes your verifier identity - users will see this address
# VERIFIER_ADDRESS=0xYourVerifierAddress...

# ============================================
# AWS KMS (Optional - Production)
# ============================================
# For production, use AWS KMS to secure the verifier private key
# Uncomment these lines and add boto3 to requirements.txt

# AWS_KMS_KEY_ID=your-kms-key-id
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# USE_KMS=true

# ============================================
# ML Model Configuration
# ============================================

# Device for inference (cuda/cpu)
# Will auto-detect GPU if available
ML_DEVICE=cuda

# Eco confidence threshold (0.0-1.0)
# Posts with score > threshold are marked as eco-friendly
ECO_THRESHOLD=0.8

# ============================================
# Celery Configuration
# ============================================

# Celery worker concurrency (number of parallel tasks)
CELERY_WORKER_CONCURRENCY=2

# Task time limit (seconds)
CELERY_TASK_TIME_LIMIT=300

# Result expiration (seconds) - 24 hours
CELERY_RESULT_EXPIRES=86400

# ============================================
# Pinata (Optional - IPFS Backup)
# ============================================
# For redundancy, pin signed verdicts to Pinata
# PINATA_JWT=your_pinata_jwt_token

# ============================================
# Monitoring & Logging
# ============================================

# Log level for ML service
LOG_LEVEL=INFO

# Enable detailed ML inference logging
ML_VERBOSE_LOGGING=false

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 
# 1. Generate Verifier Key:
#    python -c "from eth_account import Account; acc = Account.create(); print(f'Private Key: {acc.key.hex()}'); print(f'Address: {acc.address}')"
#
# 2. Place YOLOv8 Model:
#    cp your_trained_model.pt backend/ml/models/yolov8_eco.pt
#
# 3. Install Dependencies:
#    pip install -r backend/requirements.txt
#
# 4. Start Redis:
#    redis-server
#
# 5. Start IPFS:
#    ipfs daemon
#
# 6. Start Backend:
#    make dev
#
# 7. Start Celery Worker:
#    celery -A backend.ml.worker worker --loglevel=info
#
# ============================================
