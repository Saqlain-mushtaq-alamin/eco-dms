{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@eco-dms/ui": [
        "../../packages/ui/src"
      ],
      "@eco-dms/hooks": [
        "../../packages/hooks/src"
      ],
      "@eco-dms/services": [
        "../../packages/services/src"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src",
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ],
  "references": [
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/hooks"
    },
    {
      "path": "../../packages/services"
    }
  ]
}