{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "jsx": "react-jsx"
  },
  "exclude": [
    "node_modules",
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/*.venv/**",
    "**/backend.venv/**",
    "apps/web/dist",
    "apps/web/*.config.*",
    "apps/mobile/eslint.config.js",
    "apps/mobile/metro.config.js",
    "apps/mobile/index.js",
    "apps/mobile/scripts/**/*.js",
    "backend/**/*.py",
    "subgraph/scripts/**/*.js"
  ]
}