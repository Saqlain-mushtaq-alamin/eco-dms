{
  "name": "eco-dms-root",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev:web": "pnpm --filter eco-dms-web dev",
    "dev:mobile": "pnpm --filter eco-dms-mobile start",
    "dev:backend": "uvicorn app.main:app --reload --port 8000",
    "dev:contracts": "pnpm --filter eco-dms-contracts hardhat node",
    "build:web": "pnpm --filter eco-dms-web build",
    "build:mobile": "pnpm --filter eco-dms-mobile android && pnpm --filter eco-dms-mobile ios",
    "test:web": "pnpm --filter eco-dms-web test",
    "test:contracts": "pnpm --filter eco-dms-contracts test",
    "test:subgraph": "pnpm --filter eco-dms-subgraph graph:test",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r exec rm -rf node_modules dist .next .expo",
    "install:all": "pnpm install"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  },
  "dependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.2",
    "@nomicfoundation/hardhat-toolbox": "^4.0.0",
    "hardhat": "2.26.2",
    "keccak": "^3.0.4"
  },
  "pnpm": {
    "overrides": {
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "react-native": "0.81.5",
      "keccak": "3.0.4"
    }
  }
}