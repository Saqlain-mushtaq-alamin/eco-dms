{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "node",
        "strict": false,
        "types": [
            "@graphprotocol/graph-ts"
        ],
        "skipLibCheck": true,
        "noEmit": true,
        "lib": [
            "ES2020"
        ],
        "resolveJsonModule": true,
        "esModuleInterop": true
    },
    "include": [
        "src/**/*.ts",
        "generated/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "build"
    ]
}